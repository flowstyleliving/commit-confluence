+    def test_js_within_kv_groups_detects_inside_group_tension(self):
+        # 4 Q heads, 2 KV groups. Inside each KV group the two Q heads
+        # disagree, but both KV groups have the same average distribution.
+        # Therefore within-KV tension is high while between-KV tension is low.
+        w = np.zeros((4, 4), dtype=np.float64)
+        w[0] = [1, 0, 0, 0]
+        w[1] = [0, 1, 0, 0]
+        w[2] = [1, 0, 0, 0]
+        w[3] = [0, 1, 0, 0]
+        captures = self._synthetic_captures({"final": w})
+
+        within = _compute_attention_score(
+            (1, ATTENTION_FAMILY, "final_js_within_kv_groups"),
+            captures,
+            {"final": 2},
+        )
+        between = _compute_attention_score(
+            (1, ATTENTION_FAMILY, "final_js_kv_groups"),
+            captures,
+            {"final": 2},
+        )
+
+        assert within is not None and within > 0.0
+        assert between is not None
+        assert between == pytest.approx(0.0, abs=1e-6)
+
